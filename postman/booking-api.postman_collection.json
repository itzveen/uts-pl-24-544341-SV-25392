{
  "info": {
    "name": "Booking API - UTS PL",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('bookingDate')) {",
          "  const d = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);",
          "  pm.collectionVariables.set('bookingDate', d.toISOString().slice(0, 10));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000/api" },
    { "key": "token", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "bookingDate", "value": "" }
  ],
  "item": [
    {
      "name": "01 Akses tanpa token (401)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 401', () => pm.response.to.have.status(401));",
        "pm.test('Respons JSON', () => pm.expect(pm.response.json().message).to.eql('Unauthenticated.'));"
      ] } }],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/bookings"
      }
    },
    {
      "name": "02 Login gagal (401)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 401', () => pm.response.to.have.status(401));"
      ] } }],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"salah\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/login"
      }
    },
    {
      "name": "03 Login berhasil (200)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "const res = pm.response.json();",
        "pm.test('Ada token', () => pm.expect(res.token).to.be.a('string'));",
        "pm.collectionVariables.set('token', res.token);"
      ] } }],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/login"
      }
    },
    {
      "name": "04 Daftar fasilitas (200)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));"
      ] } }],
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/facilities" }
    },
    {
      "name": "05 Tambah booking (201)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 201', () => pm.response.to.have.status(201));",
        "pm.collectionVariables.set('bookingId', pm.response.json().data.id);"
      ] } }],
      "request": {
        "method": "POST",
        "header": [],
        "body": { "mode": "raw", "raw": "{\n  \"customer_name\": \"Budi Santoso\",\n  \"facility\": \"futsal\",\n  \"booking_date\": \"{{bookingDate}}\",\n  \"start_time\": \"10:00\",\n  \"end_time\": \"12:00\",\n  \"notes\": \"Latihan rutin\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/bookings"
      }
    },
    {
      "name": "06 Tambah booking tidak valid (422)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 422', () => pm.response.to.have.status(422));",
        "pm.test('Ada pesan error', () => pm.expect(pm.response.json().errors).to.be.an('object'));"
      ] } }],
      "request": {
        "method": "POST",
        "header": [],
        "body": { "mode": "raw", "raw": "{\n  \"customer_name\": \"\",\n  \"facility\": \"renang\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/bookings"
      }
    },
    {
      "name": "07 Tambah booking bentrok (422)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 422', () => pm.response.to.have.status(422));",
        "pm.test('Error jadwal bentrok', () => pm.expect(pm.response.json().errors.start_time).to.be.an('array'));"
      ] } }],
      "request": {
        "method": "POST",
        "header": [],
        "body": { "mode": "raw", "raw": "{\n  \"customer_name\": \"Andi\",\n  \"facility\": \"futsal\",\n  \"booking_date\": \"{{bookingDate}}\",\n  \"start_time\": \"11:00\",\n  \"end_time\": \"13:00\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/bookings"
      }
    },
    {
      "name": "08 Tampil semua booking (200)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Data berupa array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
      ] } }],
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/bookings" }
    },
    {
      "name": "09 Tampil satu booking (200)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));"
      ] } }],
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/bookings/{{bookingId}}" }
    },
    {
      "name": "10 Ubah booking (200)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Status jadi confirmed', () => pm.expect(pm.response.json().data.status).to.eql('confirmed'));"
      ] } }],
      "request": {
        "method": "PUT",
        "header": [],
        "body": { "mode": "raw", "raw": "{\n  \"customer_name\": \"Budi Santoso\",\n  \"facility\": \"futsal\",\n  \"booking_date\": \"{{bookingDate}}\",\n  \"start_time\": \"10:00\",\n  \"end_time\": \"12:00\",\n  \"status\": \"confirmed\",\n  \"notes\": \"Sudah dibayar\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/bookings/{{bookingId}}"
      }
    },
    {
      "name": "11 Hapus booking (200)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));"
      ] } }],
      "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/bookings/{{bookingId}}" }
    },
    {
      "name": "12 Logout (200)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));"
      ] } }],
      "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/logout" }
    }
  ]
}